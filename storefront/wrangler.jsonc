{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "schilling-interiors-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "schilling-interiors-store",
    "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": {"PUBLIC_STORE_URL": "https://REPLACE_WITH_YOUR_WORKER.workers.dev", "STRIPE_AUTOMATIC_TAX": "false"},
  "observability": {"enabled": true}
}